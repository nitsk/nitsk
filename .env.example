# Copy to .env and adjust as needed. No cloud API keys are used or required —
# everything runs against the local Ollama service defined in docker-compose.yml.

# Ollama model to pull and use for the semantic pass (docs/PDFs/images).
# Source code is parsed locally via tree-sitter and never touches the LLM.
OLLAMA_MODEL=qwen2.5-coder:7b
