# Copy to graphify/graphify.env and `source` it (or let setup.sh write it for you)
# before running `graphify`, so extraction always routes to your local Ollama
# server and never to a cloud provider.

# Local Ollama server (OpenAI-compatible endpoint). Keep this as loopback —
# graphify hard-blocks link-local/metadata addresses and warns on any
# non-loopback host.
export OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama itself needs no key, but graphify requires OLLAMA_API_KEY to be
# non-empty or it prints a warning on every run. Any placeholder value works.
export OLLAMA_API_KEY=ollama-local

# Model to use for semantic extraction (docs/PDFs/images) and community
# labeling. Must already be pulled: `ollama pull qwen2.5-coder:7b`.
export OLLAMA_MODEL=qwen2.5-coder:7b

# graphify auto-detects a backend by scanning for cloud API keys FIRST
# (gemini, kimi/moonshot, claude/anthropic, openai, deepseek, azure, bedrock)
# and only falls back to Ollama last. If any of those keys are present in
# your shell environment, auto-detect will silently prefer the paid backend
# over Ollama. For a guaranteed 100% local run, either:
#   1. unset ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY MOONSHOT_API_KEY \
#        OPENAI_API_KEY DEEPSEEK_API_KEY AZURE_OPENAI_API_KEY
#   2. or always pass --backend ollama explicitly on the command line.
